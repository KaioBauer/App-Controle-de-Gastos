# ---------- Geral ----------
NODE_ENV=production
# Domínio público do app (sem barra no final). Usado em CORS e WebAuthn.
APP_ORIGIN=https://kaixa.tech
TZ=America/Sao_Paulo
# Porta local do container web (o Nginx da VPS faz proxy para 127.0.0.1:WEB_PORT)
WEB_PORT=8088

# ---------- Postgres ----------
POSTGRES_USER=financas
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=financas
# Dentro do docker compose o host é "db". Para rodar a API fora do Docker use localhost.
DATABASE_URL=postgresql://financas:troque-por-uma-senha-forte@db:5432/financas

# ---------- Sessão ----------
# false apenas em desenvolvimento via http://localhost
COOKIE_SECURE=true
SESSION_DAYS=180

# ---------- Web Push (gere com: pnpm gen-vapid) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A Apple rejeita subjects inválidos (ex.: mailto:x@localhost). Use um e-mail real ou URL https.
VAPID_SUBJECT=mailto:voce@kaixa.tech

# ---------- Pluggy (dashboard.pluggy.ai) ----------
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Segredo do webhook (header x-webhook-secret). Gere com: openssl rand -hex 32
PLUGGY_WEBHOOK_SECRET=

# Chave que cifra as credenciais do Meu Pluggy de cada usuário (Ajustes › Conexões).
# Gere com: openssl rand -base64 32 — sem ela, só valem as credenciais acima.
CREDENTIALS_KEY=
