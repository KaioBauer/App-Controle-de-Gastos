# Nginx da VPS: /etc/nginx/sites-available/kaixa
# Gere o certificado ANTES de ativar este arquivo (ele referencia os .pem):
#   sudo certbot certonly --nginx -d kaixa.tech -d www.kaixa.tech

limit_req_zone $binary_remote_addr zone=kaixa_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=kaixa_webhook:10m rate=60r/m;

server {
  listen 80;
  listen [::]:80;
  server_name kaixa.tech www.kaixa.tech;
  return 301 https://kaixa.tech$request_uri;
}

# www -> domínio principal (o app, os cookies e o push ficam numa origem só)
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name www.kaixa.tech;
  ssl_certificate /etc/letsencrypt/live/kaixa.tech/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/kaixa.tech/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  return 301 https://kaixa.tech$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name kaixa.tech;

  ssl_certificate /etc/letsencrypt/live/kaixa.tech/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/kaixa.tech/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  server_tokens off;
  client_max_body_size 1m;

  # Headers de segurança
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "same-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  # Sobrescreve (não concatena) para que o cliente não consiga forjar o próprio IP
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto https;

  location = /api/auth/login {
    limit_req zone=kaixa_login burst=5 nodelay;
    proxy_pass http://127.0.0.1:8088;
  }

  # Webhook da Pluggy: só aceita o IP oficial dela (docs.pluggy.ai/docs/webhooks)
  location = /api/webhooks/pluggy {
    allow 52.67.145.81;
    deny all;
    limit_req zone=kaixa_webhook burst=20 nodelay;
    proxy_pass http://127.0.0.1:8088;
  }

  location / {
    proxy_pass http://127.0.0.1:8088;
  }
}
