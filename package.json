{
  "name": "financas",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db",
    "db:migrate": "pnpm --filter @financas/api prisma migrate dev",
    "create-user": "pnpm --filter @financas/api create-user",
    "gen-vapid": "pnpm --filter @financas/api gen-vapid",
    "push": "pnpm --filter @financas/api push"
  }
}
