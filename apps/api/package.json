{
  "name": "@financas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "prisma": "dotenv -e ../../.env -- prisma",
    "create-user": "tsx --env-file=../../.env src/cli/create-user.ts",
    "gen-vapid": "tsx src/cli/gen-vapid.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "6.19.3",
    "@simplewebauthn/server": "^13.3.3",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "node-cron": "4.6.0",
    "prisma": "6.19.3",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@financas/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^8.0.0",
    "tsup": "8.5.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
